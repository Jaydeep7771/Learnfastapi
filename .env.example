# Copy to .env  ->  cp .env.example .env
APP_NAME="FastAPI Mastery"
DEBUG=true

# Async SQLite via aiosqlite - zero config on macOS
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# openssl rand -hex 32
JWT_SECRET="change-me-7f3b1c9a4e2d8f6b0a5c3e1d9b7f5a3c1e9d7b5f3a1c9e7d5b3f1a9c7e5d3b1f"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Module 2 (optional). Leave empty to run the AI endpoints in deterministic MOCK mode.
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
CHAT_MODEL="gpt-4o-mini"
CHROMA_DIR="./chroma_data"
